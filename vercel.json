{
  "version": 2,
  "regions": ["sfo1"],
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 300
      }
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "data.json",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/data.json", "dest": "/data.json" },
    { "src": "/index.html", "dest": "/index.html" },
    { "src": "/(.*)", "dest": "index.js" }
  ]
}
